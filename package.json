{
  "name": "ctt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "data/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run dev --workspace=@ctt/tenerife --",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace=@ctt/tenerife --",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-static-copy": "4.1.1",
    "@types/node": "^24.0.0"
  }
}
